{
    "type": "module",
    "name": "@sciner/ts-build",
    "version": "2.0.2",
    "description": "Typescript helpers for Tesera project",
    "keywords": [
        "typescript",
        "transpile"
    ],
    "exports": {
        ".": "./ts-import/node.js",
        "./api": "./ts-import/index.js",
        "./paths": "./paths/rewrite.js"
    },
    "bin": {
        "ts-build-tsc": "./paths/cli.js"
    },
    "repository": "https://github.com/sciner/ts-build.git",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "ts-import",
        "paths"
    ],
    "engines": {
        "node": ">=20.17"
    },
    "dependencies": {
        "@swc/core": "=1.9.2",
        "es-module-lexer": "^1.7.0",
        "json5": "^2.2.3"
    }
}
